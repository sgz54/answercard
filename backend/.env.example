# ─────────────────────────────────────────────────────────────
# Answer Card backend — environment template
# Copy to .env and fill in real values. Never commit .env itself.
# ─────────────────────────────────────────────────────────────

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# PayPal (https://developer.paypal.com/dashboard/applications)
# Sandbox credentials for testing; Live credentials for production.
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret
PAYPAL_MODE=sandbox
# Webhook ID from PayPal dashboard (PAYMENT.CAPTURE.COMPLETED event)
PAYPAL_WEBHOOK_ID=

# Supabase (https://supabase.com/dashboard/project/_/settings/api)
# Use the service_role secret key, not the anon/publishable key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Frontend origin (PayPal return/cancel URLs)
FRONTEND_URL=http://localhost:5173
