# ─────────────────────────────────────────────────────────────
# Answer Card backend — environment template
# Copy to .env and fill in real values.
# ─────────────────────────────────────────────────────────────

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,https://answercard.app

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_UNLOCK=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_FOLLOWUP_PACK=price_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase (https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# Frontend origin (used for Stripe Checkout success/cancel URLs)
FRONTEND_URL=http://localhost:5173
