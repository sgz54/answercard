# API mode: "mock" runs entirely in the browser with a local divination engine.
# Switch to "real" to talk to the FastAPI backend (see /backend).
VITE_API_MODE=mock
VITE_API_BASE_URL=http://localhost:8000

# Stripe publishable key (frontend only — secret key lives in backend .env).
# Needed only when VITE_API_MODE=real.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
